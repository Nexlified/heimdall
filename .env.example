# PostgreSQL Database Configuration
POSTGRES_USER=kratos
POSTGRES_PASSWORD=secret-password
POSTGRES_DB=kratos

# Kratos Configuration
KRATOS_DSN=postgres://kratos:secret-password@kratos-db:5432/kratos?sslmode=disable&max_conns=20

# Hydra Configuration
HYDRA_DSN=memory
HYDRA_OIDC_SALT=a-very-secret-salt
HYDRA_SECRETS_SYSTEM=you-should-change-this

# Heimdall Configuration
PASETO_SYMMETRIC_KEY=12345678901234567890123456789012

# NATS Configuration
NATS_URL=nats://nats:4222

# Service URLs
KRATOS_ADMIN_URL=http://kratos:4434
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_PUBLIC_URL=http://hydra:4444
CERBOS_GRPC_URL=cerbos:3592
